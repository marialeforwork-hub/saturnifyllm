    const quizContainer = document.getElementById('quiz');
    let currentScore = 0;
    let answeredCount = 0;
    const totalQuestions = quizData.length;

    const STUDENT_ID = sessionStorage.getItem('studentId') || sessionStorage.getItem('studentName') || 'guest';
    const QUIZ_STORAGE_KEY = `quiz_draft_${STUDENT_ID}_${document.title}`;

    function renderMath() {
        if (window.MathJax && window.MathJax.typesetPromise) {
            window.MathJax.typesetPromise();
        }
    }

    function buildQuiz() {
        localStorage.setItem(QUIZ_STORAGE_KEY + '_total', quizData.length);
        quizContainer.innerHTML = '';
        createNavigatorBox(); 

        quizData.forEach((data, index) => {
            const questionBlock = document.createElement('div');
            questionBlock.classList.add('question-block');
            questionBlock.id = `question-${data.id}`;
            questionBlock.dataset.locked = "false";
            questionBlock.style.scrollMarginTop = "100px";

            let optionsHtml = '';
            if (data.options && Object.keys(data.options).length > 0) {
                for (const [key, value] of Object.entries(data.options)) {
                    optionsHtml += `
                        <li>
                            <label id="label-${data.id}-${key}">
                                <input type="radio" name="question${data.id}" value="${key}">
                                <strong>${key}.</strong> ${value}
                            </label>
                        </li>
                    `;
                }
            }

            questionBlock.innerHTML = `
                <div class="question-text">${formatQuestion(data.question, `Câu ${index + 1}: `)}</div>
                <ul class="options">${optionsHtml}</ul>
                <div class="explanation" id="explanation-${data.id}">${data.explanation || ''}</div>
            `;
            quizContainer.appendChild(questionBlock);
        });
        
        quizContainer.addEventListener('change', () => { saveProgress(); updateNavigatorState(); });
        quizContainer.addEventListener('input', () => { saveProgress(); updateNavigatorState(); });
        
        const progressEl = document.getElementById('progressText');
        if (progressEl) progressEl.innerText = `0/${totalQuestions}`;

        renderMath();
    }

    function createNavigatorBox() {
        const grid = document.getElementById('navGrid');
        if(!grid) return;
        grid.innerHTML = ''; 

        quizData.forEach((data, index) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.id = `nav_btn_${data.id}`;
            btn.className = 'nav-grid-btn';
            btn.innerText = index + 1;

            btn.onclick = () => {
                const targetBlock = document.getElementById(`question-${data.id}`);
                if (targetBlock) targetBlock.scrollIntoView({ behavior: 'smooth' });
            };
            grid.appendChild(btn);
        });
    }

    const toggleSidebarBtn = document.getElementById('toggleSidebarBtn');
    const questionListPanel = document.getElementById('questionListPanel');
    
    if (toggleSidebarBtn && questionListPanel) {
        toggleSidebarBtn.addEventListener('click', () => {
            questionListPanel.classList.toggle('collapsed');
        });
    }

    const toggleNavBtn = document.getElementById('toggleNavBtn');
    const stickyFooter = document.getElementById('stickyFooter');
    const toggleIcon = document.getElementById('toggleIcon');
    const toggleText = document.getElementById('toggleText');

    toggleNavBtn.addEventListener('click', () => {
        if (stickyFooter.classList.contains('hidden')) {
            stickyFooter.classList.remove('hidden');
            toggleIcon.innerText = '👁️';
            toggleText.innerText = 'Ẩn thanh công cụ';
        } else {
            stickyFooter.classList.add('hidden');
            toggleIcon.innerText = '👀';
            toggleText.innerText = 'Hiện thanh công cụ';
        }
    });

    function updateNavigatorState() {
        quizData.forEach((data) => {
            let hasAnswered = false;
            const selected = document.querySelector(`input[name="question${data.id}"]:checked`);
            if (selected) hasAnswered = true;

            const btn = document.getElementById(`nav_btn_${data.id}`);
            if (btn) {
                if (hasAnswered) {
                    btn.style.background = '#2ecc71'; 
                    btn.style.color = '#ffffff'; 
                    btn.style.borderColor = '#27ae60';
                } else if (document.getElementById(`question-${data.id}`).dataset.locked !== "true") {
                    btn.style.background = '#f8f9fa'; 
                    btn.style.color = '#2c3e50'; 
                    btn.style.borderColor = '#bdc3c7';
                }
            }
        });
    }

    function saveProgress() {
        let userAnswers = {};
        quizData.forEach(data => {
            const selectedOption = document.querySelector(`input[name="question${data.id}"]:checked`);
            if (selectedOption) userAnswers[data.id] = selectedOption.value;
        });
        localStorage.setItem(QUIZ_STORAGE_KEY, JSON.stringify(userAnswers));
    }

    function checkAndRestoreProgress() {
        const savedDraft = localStorage.getItem(QUIZ_STORAGE_KEY);
        if (!savedDraft) return;

        const userAnswers = JSON.parse(savedDraft);
        const count = Object.keys(userAnswers).length;

        if (count > 0) {
            const confirmResume = confirm(
                `Em đang làm dở ${count}/${totalQuestions} câu ở lần trước.\n\n` +
                `• Bấm [OK] để LÀM TIẾP bài đang dở.\n` +
                `• Bấm [Hủy (Cancel)] để LÀM LẠI TỪ ĐẦU.`
            );

            if (confirmResume) {
                let lastAnsweredId = null;
                Object.entries(userAnswers).forEach(([qId, value]) => {
                    const radio = document.querySelector(`input[name="question${qId}"][value="${value}"]`);
                    if (radio) {
                        radio.checked = true;
                        lastAnsweredId = qId;
                    }
                });

                updateNavigatorState();

                if (lastAnsweredId) {
                    const targetBlock = document.getElementById(`question-${lastAnsweredId}`);
                    if (targetBlock) {
                        targetBlock.scrollIntoView({ behavior: 'smooth' });
                    }
                }
            } else {
                startTime = new Date();
                localStorage.removeItem(QUIZ_STORAGE_KEY);
            }
        }
    }

    function checkCurrentAnswers() {
        let checkedAny = false;

        quizData.forEach(data => {
            const block = document.getElementById(`question-${data.id}`);
            if (block.dataset.locked === "true") return;

            const correctAnswer = (data.correctAnswer || '').toString().trim().toLowerCase();
            const selectedOption = document.querySelector(`input[name="question${data.id}"]:checked`);
            
            if (selectedOption) {
                checkedAny = true;
                const userAnswer = selectedOption.value.trim().toLowerCase();
                
                if (userAnswer === correctAnswer) {
                    document.getElementById(`label-${data.id}-${selectedOption.value}`).classList.add('correct-answer-label');
                    currentScore++;
                } else {
                    document.getElementById(`label-${data.id}-${selectedOption.value}`).classList.add('wrong-answer-label');
                    const correctKey = data.correctAnswer;
                    if (document.getElementById(`label-${data.id}-${correctKey}`)) {
                        document.getElementById(`label-${data.id}-${correctKey}`).classList.add('correct-answer-label');
                    }
                }

                const explanationEl = document.getElementById(`explanation-${data.id}`);
                if (explanationEl && data.explanation) {
                    explanationEl.style.display = 'block';
                    explanationEl.innerHTML = `<strong>Giải thích:</strong> ${data.explanation}`;
                }

                const radios = document.querySelectorAll(`input[name="question${data.id}"]`);
                radios.forEach(radio => radio.disabled = true);
                block.dataset.locked = "true";
                answeredCount++;
            }
        });

        if (!checkedAny) {
            alert('Bạn chưa chọn đáp án nào để kiểm tra!');
        } else {
            updateScoreBoard();
            saveAdminResultData();

            if (answeredCount === totalQuestions) {
                alert(`Chúc mừng! Bạn đã hoàn thành toàn bộ ${totalQuestions} câu hỏi. Tổng điểm: ${currentScore}/${totalQuestions}.`);
                localStorage.removeItem(QUIZ_STORAGE_KEY);
            }
        }
    }

    let startTime = new Date();

    function saveAdminResultData() {
        const endTime = new Date();
        const durationSec = Math.max(0, Math.round((endTime - startTime) / 1000));
        const durationMin = (durationSec / 60).toFixed(1);

        const quizTitle = document.title || 'Bài tập SAT';
        let studentAnswers = {};

        quizData.forEach((data, index) => {
            const selected = document.querySelector(`input[name="question${data.id}"]:checked`);
            studentAnswers[`Câu ${index + 1}`] = selected ? selected.value : 'Bỏ trống';
        });

        let history = JSON.parse(localStorage.getItem('sat_results') || '[]');
        const attemptCount = history.filter(h => h.studentName === STUDENT_ID && h.quizTitle === quizTitle).length + 1;

        const resultData = {
            id: Date.now(),
            studentName: STUDENT_ID,
            quizTitle: quizTitle,
            attempt: attemptCount,
            score: `${currentScore}/${totalQuestions}`,
            percentage: Math.round((currentScore / totalQuestions) * 100) + '%',
            answers: studentAnswers,
            startTime: startTime.toLocaleTimeString('vi-VN') + ' ' + startTime.toLocaleDateString('vi-VN'),
            endTime: endTime.toLocaleTimeString('vi-VN') + ' ' + endTime.toLocaleDateString('vi-VN'),
            duration: `${durationMin} phút (${durationSec}s)`
        };

        history.push(resultData);
        localStorage.setItem('sat_results', JSON.stringify(history));

        if (window.parent && window.parent !== window) {
            window.parent.postMessage({ type: 'SAT_SUBMIT_RESULT', data: resultData }, '*');
        }
    }

