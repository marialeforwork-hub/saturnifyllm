        currentScore = 0;
        answeredCount = 0;
        startTime = new Date();
        
        localStorage.removeItem(QUIZ_STORAGE_KEY);
        
        quizData.forEach(data => {
            const block = document.getElementById(`question-${data.id}`);
            if (block) {
                block.dataset.locked = "false";
                
                const radios = document.querySelectorAll(`input[name="question${data.id}"]`);
                radios.forEach(radio => {
                    radio.disabled = false;
                    radio.checked = false;
                });
                if (data.options) {
                    for (const key of Object.keys(data.options)) {
                        const lbl = document.getElementById(`label-${data.id}-${key}`);
                        if (lbl) {
                            lbl.classList.remove('correct-answer-label', 'wrong-answer-label');
                        }
                    }
                }

                const explanationEl = document.getElementById(`explanation-${data.id}`);
                if (explanationEl) explanationEl.style.display = 'none';

                const navBtn = document.getElementById(`nav_btn_${data.id}`);
                if (navBtn) {
                    navBtn.style.background = '#f8f9fa';
                    navBtn.style.color = '#2c3e50';
                    navBtn.style.borderColor = '#bdc3c7';
                }
            }
        });
        updateScoreBoard();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function updateScoreBoard() {
        const progressEl = document.getElementById('progressText');
        const scoreEl = document.getElementById('scoreText');
        if (progressEl) progressEl.innerText = `${answeredCount}/${totalQuestions}`;
        if (scoreEl) scoreEl.innerText = currentScore;
    }

    document.getElementById('checkBtn').addEventListener('click', checkCurrentAnswers);
    document.getElementById('resetBtn').addEventListener('click', resetQuiz);

    buildQuiz();
    checkAndRestoreProgress();
</script>
    <script src="quiz-pager.js" defer></script>
</body>
</html>
